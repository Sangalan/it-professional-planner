# OAuth 2.0 Web client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Comma-separated exact email addresses allowed to use the application.
ALLOWED_EMAILS=you@example.com,colleague@example.com

# Random value with at least 32 characters. Generate one with: openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-secret
